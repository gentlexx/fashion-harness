{
  "name": "@gentlexx/dsh-client-ui-fashion-shell",
  "description": "Fashion Harness product shell: project-first sidebar, main panel, and light History routing",
  "version": "0.1.5-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@gentlexx/dsh-api-fashion-project-controller",
        "@gentlexx/dsh-api-fashion-research-controller",
        "@gentlexx/dsh-api-fashion-analysis-controller",
        "@gentlexx/dsh-api-fashion-design-controller",
        "@gentlexx/dsh-api-fashion-feedback-controller",
        "@gentlexx/dsh-api-fashion-evaluation-controller",
        "@gentlexx/dsh-api-fashion-agent-controller",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@gentlexx/dsh-api-fashion-agent-controller": "workspace:^",
    "@gentlexx/dsh-api-fashion-analysis-controller": "workspace:^",
    "@gentlexx/dsh-api-fashion-design-controller": "workspace:^",
    "@gentlexx/dsh-api-fashion-evaluation-controller": "workspace:^",
    "@gentlexx/dsh-api-fashion-feedback-controller": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
    "@gentlexx/dsh-fashion-agent": "workspace:^",
    "@gentlexx/dsh-fashion-evaluation": "workspace:^",
    "@gentlexx/dsh-api-fashion-project-controller": "workspace:^",
    "@gentlexx/dsh-api-fashion-research-controller": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-store": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@gentlexx/dsh-fashion-analysis": "workspace:^",
    "@gentlexx/dsh-fashion-design": "workspace:^",
    "@gentlexx/dsh-fashion-feedback": "workspace:^",
    "@gentlexx/dsh-fashion-project": "workspace:^",
    "@gentlexx/dsh-fashion-research": "workspace:^",
    "@deepseek-ai/dsh-host-frontend-static": "workspace:^",
    "@deepseek-ai/dsh-util-crypto": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "private": true
}
