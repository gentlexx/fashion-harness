# Optional: only required for live DeepSeek model actions.
# The deterministic Fashion workbench should be browsable without this value.
DEEPSEEK_API_KEY=

# Optional provider endpoint override. Leave empty to use the configured default.
DEEPSEEK_BASE_URL=

# Never commit a populated .env file. Prefer the Models settings UI or a
# process-scoped environment variable, and use an isolated DSH_HOME for review.
